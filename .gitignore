# GSD planning artifacts; local-only at the source repo root. The pattern is
# root-anchored so it does NOT match nested `.planning/` directories under
# `shared/extras/<logical>/` in the sync-repo mirror (Phase 19 extras-sync
# would otherwise silently fail at the git-add boundary).
/.planning/
/.claude
/CLAUDE.md
/graphify-out
docs-site/dist/
docs-site/node_modules/
docs-site/.astro/
.fallow/
.stryker-tmp/
reports/
.test-bundle/

# Local dev-loop caches (speed only; never restored in CI, so CI always runs
# cold/full). tsc --incremental buildinfo and ESLint's --cache file. Prettier's
# cache lives under node_modules/.cache and is already ignored via node_modules.
.tsbuildinfo
.eslintcache
