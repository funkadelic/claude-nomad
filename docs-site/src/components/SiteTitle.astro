---
// Replaces Starlight's SiteTitle so the header brand matches the hero image:
// a green ">_" prompt glyph followed by "nomad", trailed by a muted version
// badge. Link target and base styles mirror the stock component; only the
// inner markup differs. The version reads from the root package.json (the
// single source of truth bumped by release-please), so the docs always show
// the version they were built from. The Pages deploy runs on release publish,
// so the live badge tracks the newest published npm version.
import pkg from '../../../package.json';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="brand">
  <a href={siteTitleHref} class="site-title sl-flex">
    <span translate="no" aria-label="claude-nomad" class="wordmark">
      <span class="prompt-glyph" aria-hidden="true">&gt;_</span> nomad
    </span>
  </a>
  <span translate="no" class="version-badge">v{pkg.version}</span>
</div>

<style>
  @layer starlight.core {
    /* Own the flex context for the wordmark + version badge so they share a
       baseline. Starlight's title-wrapper centers its children, so aligning
       the badge alone there just floats it to the top; wrapping both in a
       baseline-aligned box is what actually seats the badge on the wordmark's
       baseline. */
    .brand {
      display: flex;
      align-items: baseline;
      min-width: 0;
    }
    .site-title {
      align-items: center;
      gap: var(--sl-nav-gap);
      font-size: var(--sl-text-h4);
      font-weight: 600;
      color: var(--sl-color-text-accent);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }
    span {
      overflow: hidden;
    }
    /* Match the hero wordmark: off-white "nomad" (#f4f4f2 via --sl-color-white)
       next to the green prompt glyph. */
    .wordmark {
      color: var(--sl-color-white);
    }
    /* Muted version pill trailing the wordmark: small, dim, non-clickable so
       it reads as metadata rather than a second brand element. */
    .version-badge {
      margin-inline-start: 0.5rem;
      padding: 0.1em 0.45em;
      border-radius: 0.35rem;
      background: var(--sl-color-gray-6);
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-xs);
      font-variant-numeric: tabular-nums;
      line-height: 1.4;
      white-space: nowrap;
    }
  }
</style>
